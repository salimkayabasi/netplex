# NetPlex Environment Variables Configuration Example

# Path to the SQLite database file
NETPLEX_DB_PATH=/config/netplex.db

# Path to the configuration directory (logs, cached CSS, etc.)
NETPLEX_CONFIG_DIR=/config

# Path to the temporary cache directory (for TSV downloads during crawling)
NETPLEX_CACHE_DIR=/config/cache

# Path to the media output directory (where trailers and NFOs are stored)
NETPLEX_DATA_DIR=/data

# Application server binding host and port
NETPLEX_HOST=0.0.0.0
NETPLEX_PORT=8000

# Logging level (DEBUG, INFO, WARNING, ERROR)
NETPLEX_LOG_LEVEL=INFO

# Filter console logs by logger name (e.g. netplex.crawler)
NETPLEX_LOG_FILTER=netplex.crawler
